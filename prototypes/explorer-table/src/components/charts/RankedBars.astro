---
// PROTOTYPE chart: ranked horizontal bars as an HTML list (labels never clip).
// With `records`, each row opens to list the proceedings behind it.
import type { Proceeding } from "../../lib/proceedings";
import { formatDate, recordHref } from "../../lib/proceedings";

type Props = {
  items: [string, number][];
  label: string;
  records?: (key: string) => Proceeding[];
  display?: (key: string) => string;
};
const { items, label, records, display = (k: string) => k } = Astro.props as Props;
const max = Math.max(...items.map(([, n]) => n));
---
<ol class="bars" aria-label={label}>
  {items.map(([key, n]) => {
    const row = (
      <>
        <span class="name">{display(key)}</span>
        <span class="track"><span class="fill" style={`width:${(n / max) * 100}%`}></span></span>
        <span class="value num">{n}</span>
      </>
    );
    return records ? (
      <li>
        <details>
          <summary class="row" title={`Show the ${n} proceedings`}>{row}</summary>
          <ul class="records">
            {records(key).map((p) => (
              <li><a href={recordHref(p.id)}>{p.title}</a> <span class="muted num">{formatDate(p.date)}</span></li>
            ))}
          </ul>
        </details>
      </li>
    ) : (
      <li class="row">{row}</li>
    );
  })}
</ol>

<style>
  .bars { list-style: none; margin: 0; padding: 0; max-width: 52rem; }
  .row { display: grid; grid-template-columns: minmax(150px, 15rem) 1fr 2.5rem; gap: 12px; align-items: center; padding: 5px 0; }
  summary.row { cursor: pointer; list-style: none; }
  summary.row::-webkit-details-marker { display: none; }
  summary.row:hover .name { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  details[open] summary.row .name { font-weight: 600; }
  .name { font-size: 14px; }
  .track { height: 12px; }
  .fill { display: block; height: 12px; background: var(--accent); border-radius: 0 4px 4px 0; min-width: 2px; }
  .value { text-align: right; font-size: 13px; color: var(--muted); }
  .records { margin: 4px 0 14px; padding: 0 0 0 1rem; border-left: 2px solid var(--rule); font-size: 13.5px; }
  .records li { list-style: none; padding: 3px 0; }
  .records a { color: var(--ink); }
  @media (max-width: 640px) {
    .row { grid-template-columns: 1fr 2.5rem; }
    .track { grid-column: 1 / -1; grid-row: 2; }
  }
</style>
