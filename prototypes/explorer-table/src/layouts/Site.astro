---
// PROTOTYPE: the frame every page shares: header with navigation, footer with provenance.
import "../styles/base.css";
import { formatDate } from "../lib/proceedings";
import { asOf } from "../lib/tracker";

type Props = { title: string; description?: string };
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
const nav = [
  { href: base, label: "Situation report" },
  { href: `${base}method/`, label: "Method and sources" },
  { href: `${base}about/`, label: "About" },
];
const here = Astro.url.pathname;
const isCurrent = (href: string) => (href === base ? here === base : here.startsWith(href));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fira+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Fira+Sans+Condensed:wght@500;600;700&display=swap" />
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <header class="masthead">
      <div class="col bar">
        <a class="wordmark" href={base}>Germany on AI</a>
        <nav aria-label="Main">
          {nav.map((n) => (
            <a href={n.href} aria-current={isCurrent(n.href) ? "page" : undefined}>{n.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main class="col">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="col">
        <p>
          Parliamentary data up to {formatDate(asOf)}. Code MIT, data CC BY 4.0.
          <a href={`${base}method/`}>How this is made</a>. Prototype, not yet published.
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .masthead { border-top: 5px solid var(--ink); border-bottom: 1px solid var(--rule); }
  .bar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 8px 24px; padding-top: 16px; padding-bottom: 0; }
  .wordmark { font-family: var(--display); font-size: 22px; font-weight: 700; letter-spacing: -0.01em; color: var(--ink); text-decoration: none; padding-bottom: 12px; }
  nav { display: flex; gap: 22px; }
  nav a {
    font-size: 15px; font-weight: 500; color: var(--muted); text-decoration: none;
    padding-bottom: 13px; border-bottom: 2px solid transparent; margin-bottom: -1px;
  }
  nav a:hover { color: var(--ink); }
  /* The current page is marked by a rule that sits on the masthead's own border. */
  nav a[aria-current="page"] { color: var(--ink); border-bottom-color: var(--ink); }
  .site-footer { border-top: 1px solid var(--rule); margin-top: 32px; }
  .site-footer p { font-size: 13px; color: var(--muted); padding: 18px 0 40px; margin: 0; }
</style>
