---
// PROTOTYPE: one static page per proceeding (permalink; works without JavaScript).
import Site from "../../layouts/Site.astro";
import data from "../../data/vorgaenge.json";
import { formatDate, ordinal } from "../../lib/proceedings";
import AnswerPairs from "../../components/AnswerPairs.astro";
import { answersFor, ministryName } from "../../lib/tracker";

export function getStaticPaths() {
  return data.map((p) => ({ params: { id: p.id }, props: { p } }));
}
const { p } = Astro.props;
const known = new Set(data.map((d) => d.id));
const answered = answersFor(p.id);

// English labels for DIP's step names; anything unlisted keeps DIP's own wording.
const STEP: Record<string, string> = {
  "Kleine Anfrage": "Minor interpellation submitted",
  "Große Anfrage": "Major interpellation submitted",
  "Schriftliche Frage": "Written question",
  "Mündliche Frage": "Oral question",
  "Antwort": "Government answer",
  "Ergänzende Antwort": "Supplementary government answer",
  "Antrag": "Motion tabled",
  "Gesetzentwurf": "Bill introduced",
  "Beratung": "Debate in plenary",
  "1. Beratung": "First reading",
  "2. Beratung": "Second reading",
  "3. Beratung": "Third reading",
  "Beschlussempfehlung und Bericht": "Committee recommendation and report",
  "Unterrichtung": "Briefing to parliament",
};
const ROLE_GROUPS: [string, (a: string) => boolean][] = [
  ["Asked or tabled by", (a) => ["Frage", "Kleine Anfrage", "Große Anfrage", "Antrag", "Entschließungsantrag", "Gesetzentwurf"].includes(a)],
  ["Answered by", (a) => a.startsWith("Antwort")],
  ["Speakers", (a) => a.startsWith("Rede") || a === "Zwischenfrage"],
];
const seen = new Set<string>();
const peopleBy = ROLE_GROUPS.map(([label, match]) => [
  label,
  p.people.filter((x) => match(x.activity) && !seen.has(`${label}|${x.name}`) && seen.add(`${label}|${x.name}`)),
] as const).filter(([, list]) => list.length);
---
<Site title={p.title}>
  <article class="record">
    <p class="crumb"><a href={import.meta.env.BASE_URL}>Back to the situation report</a></p>
    <p class="muted num">{p.type}, {ordinal(p.term)} Bundestag, latest document {formatDate(p.date)}</p>
    <h1>{p.title}</h1>
    {p.abstract && <p class="abstract">{p.abstract}</p>}
    <dl>
      <dt>Status</dt><dd>{p.status}</dd>
      <dt>Subject areas</dt><dd>{p.subjects.join(", ") || "–"}</dd>
      <dt>Keywords</dt><dd>{p.descriptors.join(", ") || "–"}</dd>
      {p.laws.length > 0 && <><dt>Laws</dt><dd>{p.laws.join("; ")}</dd></>}
      {p.institutions.length > 0 && <><dt>Institutions</dt><dd>{p.institutions.join(", ")}</dd></>}
      {p.linked.length > 0 && (
        <><dt>Linked</dt><dd>{p.linked.map((l) => (
          <div>{l.relation}: {known.has(l.id) ? <a href={`${import.meta.env.BASE_URL}vorgang/${l.id}/`}>{l.title}</a> : l.title}</div>
        ))}</dd></>
      )}
    </dl>
    {peopleBy.length > 0 && (
      <section class="people">
        <h2>People</h2>
        <dl>
          {peopleBy.map(([label, list]) => (
            <><dt>{label}</dt><dd>{list.slice(0, 6).map((x) => x.role === "MdB" ? `${x.name} (${x.affiliation})` : `${x.name}, ${x.affiliation}`).join("; ")}{list.length > 6 && ` and ${list.length - 6} others`}</dd></>
          ))}
        </dl>
      </section>
    )}
    {answered.map((a) => (
      <section class="answers" id="answers">
        <h2>The government's answer</h2>
        <p class="muted">
          {formatDate(a.date)}, {ministryName(a.ministry)}, {a.pairs.length} questions.
          Quoted in German as published.{" "}
          <a href={a.pdf} target="_blank" rel="external noopener">Printed paper {a.number}</a>
        </p>
        <AnswerPairs answer={a} />
      </section>
    ))}
    {p.steps.length > 0 && (
      <section class="steps">
        <h2>Steps</h2>
        <ol>
          {p.steps.map((s) => (
            <li>
              <span class="when num">{s.date ? formatDate(s.date) : ""}</span>
              <span>
                {STEP[s.step] ?? s.step}
                {s.by && <span class="muted">, {s.by}</span>}
                {s.pdf && <> <a href={s.pdf} target="_blank" rel="external noopener">{s.document}</a></>}
              </span>
            </li>
          ))}
        </ol>
      </section>
    )}
    <section class="source">
      <h2>Source</h2>
      <p><a href={p.url} target="_blank" rel="external noopener">This proceeding in DIP, the Bundestag's documentation system</a></p>
      <p class="muted num">Record <code>dip:vorgang:{p.id}</code>, retrieved {formatDate(p.retrievedAt)}, content hash <code>{p.hash.slice(0, 16)}</code>.</p>
    </section>
  </article>
</Site>

<style>
  .record { max-width: 760px; padding-top: 24px; padding-bottom: 60px; }
  .crumb { font-size: 14px; }
  h1 { font-size: 30px; line-height: 1.2; margin: 6px 0 16px; }
  .abstract { font-size: 17px; }
  dl { display: grid; grid-template-columns: 140px 1fr; gap: 10px 18px; margin: 24px 0; }
  dt { color: var(--muted); }
  dd { margin: 0; }
  .source { border-top: 1px solid var(--rule); margin-top: 28px; padding-top: 8px; }
  .people, .steps, .answers { border-top: 1px solid var(--rule); margin-top: 24px; padding-top: 4px; }
  .people h2, .steps h2, .answers h2, .source h2 { font-size: 18px; }
  .steps ol { list-style: none; padding: 0; margin: 0; }
  .steps li { display: grid; grid-template-columns: 7.5rem 1fr; gap: 12px; padding: 5px 0; border-bottom: 1px solid var(--rule); font-size: 15px; }
  .source h2 { font-size: 16px; }
  code { font-size: 12.5px; }
</style>
