---
// The frame every page shares: header with navigation, footer with provenance.
import "@fontsource/fira-sans/400.css";
import "@fontsource/fira-sans/400-italic.css";
import "@fontsource/fira-sans/500.css";
import "@fontsource/fira-sans/600.css";
import "@fontsource/fira-sans/700.css";
import "@fontsource/fira-sans-condensed/500.css";
import "@fontsource/fira-sans-condensed/600.css";
import "@fontsource/fira-sans-condensed/700.css";
import "../styles/base.css";
import site from "../data/site.json";
import { formatDate } from "../lib/proceedings";
import { asOf } from "../lib/tracker";

type Props = { title: string; description?: string };
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
const nav = [
  { href: base, label: "Situation report" },
  { href: `${base}method/`, label: "Method and sources" },
  { href: `${base}about/`, label: "About" },
];
const here = Astro.url.pathname;
const isCurrent = (href: string) => (href === base ? here === base : here.startsWith(href));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <header class="masthead">
      <div class="col bar">
        <div class="brand">
          <p class="name">
            <a class="wordmark" href={base}>Germany on AI</a>
            <span class="release">Alpha {site.version}</span>
          </p>
          <p class="tagline">Independent project, not government-affiliated.</p>
        </div>
        <nav aria-label="Main">
          {nav.map((n) => (
            <a href={n.href} aria-current={isCurrent(n.href) ? "page" : undefined}>{n.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main class="col">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="col">
        <p>
          Parliamentary data up to {formatDate(asOf)}. Code MIT, data CC BY 4.0.{" "}
          <a href={`${base}method/`}>How this is made</a>. Alpha, version {site.version}.
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .masthead { border-top: 5px solid var(--ink); border-bottom: 1px solid var(--rule); }
  .bar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 8px 24px; padding-top: 16px; padding-bottom: 0; }
  .brand { padding-bottom: 12px; }
  .name { margin: 0; display: flex; align-items: flex-start; gap: 6px; }
  /* Says on every page, as part of the name, that the site is not an official one. */
  .tagline { margin: 2px 0 0; font-size: 13px; line-height: 1.3; color: var(--muted); }
  /* Release stage beside the wordmark: small, raised to its cap height like a superscript,
     so it reads as part of the name rather than as a button. */
  .release { font-family: var(--display); font-size: 13px; font-weight: 600; line-height: 1; color: var(--muted); margin-top: 7px; }
  .wordmark { font-family: var(--display); font-size: 22px; font-weight: 700; letter-spacing: -0.01em; line-height: 1.2; color: var(--ink); text-decoration: none; }
  nav { display: flex; gap: 22px; }
  nav a {
    font-size: 15px; font-weight: 500; color: var(--muted); text-decoration: none;
    padding-bottom: 13px; border-bottom: 2px solid transparent; margin-bottom: -1px;
  }
  nav a:hover { color: var(--ink); }
  /* The current page is marked by a rule that sits on the masthead's own border. */
  nav a[aria-current="page"] { color: var(--ink); border-bottom-color: var(--ink); }
  .site-footer { border-top: 1px solid var(--rule); margin-top: 32px; }
  .site-footer p { font-size: 13px; color: var(--muted); padding: 18px 0 40px; margin: 0; }
</style>
